
{
  "expo": {
    "name": "WorldSport",
    "slug": "WorldSport",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "worldsport",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naor823.WorldSport",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses GPS to detect your live location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.naor823.WorldSport",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WorldSport to use your location to find nearby football matches."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#eab308"
        }
      ],
      "expo-image",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030703"
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2274b6b6-5536-4814-9c5c-a454fec34b17"
      }
    },
    "owner": "naoryaish8"
  }
}
