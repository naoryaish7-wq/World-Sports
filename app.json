{
  "expo": {
    "name": "World Sports",
    "slug": "WorldSport",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "worldsports",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naor823.WorldSports",
      "buildNumber": "7",
      "deploymentTarget": "16.4",
      "icon": "./assets/notification-icon.png",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.naor823.WorldSports"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "World Sports",
        "NSLocationWhenInUseUsageDescription": "This app uses GPS to detect your live location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.naor823.WorldSport",
      "icon": "./assets/notification-icon.png",
      "versionCode": 15,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow WorldSport to use your location to find nearby football matches."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#eab308"
        }
      ],
      "expo-image",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030703"
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-audio",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.562029576530-hafa1usttf58rlflt06uohkruev7t3a5"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2274b6b6-5536-4814-9c5c-a454fec34b17"
      }
    },
    "owner": "naoryaish8"
  }
}